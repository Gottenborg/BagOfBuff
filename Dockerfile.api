# Bag of Buff API (Elysia on Bun). Built from the monorepo root:
#   fly deploy --config fly.api.toml
FROM oven/bun:1.3.11 AS base
WORKDIR /app

# Install the whole workspace (the API resolves its deps from the root install).
COPY . .
RUN bun install --frozen-lockfile

ENV NODE_ENV=production
# Must match http_service.internal_port in fly.api.toml. Bun.serve binds
# 0.0.0.0 by default, so the API is reachable from Fly's proxy.
ENV PORT=3001
EXPOSE 3001

CMD ["bun", "apps/api/src/index.ts"]
