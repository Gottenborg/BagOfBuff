# Bag of Buff storefront (TanStack Start / Nitro SSR). Built from the monorepo
# root. VITE_* values are inlined at build time, so they come in as build args:
#   fly deploy --config fly.shop.toml \
#     --build-arg VITE_API_URL=https://api.bagofbuff.com \
#     --build-arg VITE_PLAUSIBLE_DOMAIN=bagofbuff.com
FROM oven/bun:1.3.11 AS build
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile

# Build-time public config (inlined into the client + SSR bundles by Vite).
ARG VITE_API_URL
ARG VITE_PLAUSIBLE_DOMAIN
ENV VITE_API_URL=$VITE_API_URL \
    VITE_PLAUSIBLE_DOMAIN=$VITE_PLAUSIBLE_DOMAIN

# Turbo builds @repo/shop and its workspace deps (ui, api-client) + routes.
RUN bunx turbo run build --filter=@repo/shop

# Nitro's node-server output is self-contained; run it on a slim Node image.
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Must match http_service.internal_port in fly.shop.toml.
ENV PORT=3000
COPY --from=build /app/apps/shop/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
