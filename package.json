{
  "name": "BagOfBuff",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "ci": "turbo run build check-types lint test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.11"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
