# Supabase Postgres connection string (use the pooler URL, port 6543, for runtime).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Port the API listens on.
PORT=3001

# Comma-separated browser origins allowed by CORS (storefront + admin).
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
