# Supabase Postgres connection string (use the pooler URL, port 6543, for runtime).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Port the API listens on.
PORT=3001

# Comma-separated browser origins allowed by CORS (storefront + admin).
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Supabase project URL — used to verify auth JWTs against the project's JWKS
# at <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Leave empty to disable auth.
SUPABASE_URL="https://sumxigmxbtickbfkzrxf.supabase.co"

# --- Stripe (checkout, Billing, webhooks) ---------------------------------
# Secret API key. Leave empty to disable checkout/subscriptions (the app still
# boots; those endpoints return 503).
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret for POST /checkout/webhook (from the Stripe dashboard
# or `stripe listen`). Required to accept webhooks.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Stripe redirects after hosted checkout. {CHECKOUT_SESSION_ID} is
# substituted by Stripe; the API also appends the order id.
CHECKOUT_SUCCESS_URL="http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}"
CHECKOUT_CANCEL_URL="http://localhost:3000/checkout"

# --- Resend (transactional email) -----------------------------------------
# API key. Leave empty to make email a logged no-op (checkout still completes).
RESEND_API_KEY="re_..."
# Verified sender for order/subscription emails.
ORDER_FROM_EMAIL="Bag of Buff <orders@bagofbuff.com>"
